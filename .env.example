# App settings
# DATABASE_URL is for local app runs outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_catalog
# DATABASE_URL_DOCKER is used by docker-compose for the app container.
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:postgres@db:5432/product_catalog
JWT_SECRET='replace-with-a-strong-secret'
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# Postgres container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_catalog
